---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CardSearch from '@components/CardSearch.astro';

const conditions = await getCollection('conditions');
---

<BaseLayout title="Conditions — D&D 5e" skin="dnd5e" current="/compendium/dnd5e/conditions">
  <h1 class="page-title">Condition Codex</h1>
  <p class="page-sub">Every 5e condition with its full mechanical effects.</p>

  <CardSearch target="conditions" placeholder="Search conditions…" />

  <div class="bento" id="conditions">
    {conditions.map(({ data: c }) => (
      <article class="card cond" data-name={c.name} style={`--cond-color:${c.color}`}>
        <h3>
          <span class="icon" set:html={c.icon} />
          {c.name}
        </h3>
        {c.effects && (
          <ul>
            {c.effects.map((e: string) => (
              <li>{e}</li>
            ))}
          </ul>
        )}
        {'levels' in c && Array.isArray(c.levels) && (
          <ol class="levels">
            {(c.levels as { level: number; effect: string }[]).map((l) => (
              <li>
                <b class="num">{l.level}</b> {l.effect}
              </li>
            ))}
          </ol>
        )}
        {'notes' in c && typeof c.notes === 'string' && <p class="muted">{c.notes}</p>}
      </article>
    ))}
  </div>
</BaseLayout>

<style>
  .cond { border-top: 3px solid var(--cond-color, var(--accent)); }
  .cond .icon { display: inline-flex; width: 22px; height: 22px; color: var(--cond-color, var(--accent)); }
  .cond .icon :global(svg) { width: 100%; height: 100%; }
  .cond ul, .cond ol { margin: 0; padding-left: 1.1rem; font-size: .85rem; color: var(--ink-muted); display: flex; flex-direction: column; gap: .3rem; }
  .levels { list-style: none; padding-left: 0 !important; }
  .cond p { font-size: .8rem; }
</style>
