{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["src/lib/*"],
      "@rulesets/*": ["src/rulesets/*"],
      "@components/*": ["src/components/*"],
      "@islands/*": ["src/islands/*"]
    }
  }
}
